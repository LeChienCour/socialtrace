POSTGRES_DB=socialtrace
POSTGRES_USER=socialtrace
POSTGRES_PASSWORD=change-me

SOCIALTRACE_API_TOKEN=
SOCIALTRACE_ENVIRONMENT=development

# Only read by the Quadlet units (quadlet/*.container), not by compose —
# compose derives these from the POSTGRES_* values above at template time,
# but Quadlet unit files can't do that cross-referencing, so they're
# spelled out here directly. Keep these in sync with POSTGRES_DB/USER/
# PASSWORD above if you change them. socialtrace-db is the Quadlet
# container's name, resolvable on the socialtrace Quadlet network.
SOCIALTRACE_POSTGRES_HOST=socialtrace-db
SOCIALTRACE_POSTGRES_PORT=5432
SOCIALTRACE_POSTGRES_DB=socialtrace
SOCIALTRACE_POSTGRES_USER=socialtrace
SOCIALTRACE_POSTGRES_PASSWORD=change-me
